// The provider line is set automatically from DATABASE_URL by
// scripts/set-db-provider.mjs (sqlite locally, postgresql in production).
// Don't use enums or lists here: SQLite doesn't support them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  banned       Boolean  @default(false)
  isSeed       Boolean  @default(false)
  createdAt    DateTime @default(now())

  sessions  Session[]
  questions Question[]
  answers   Answer[]
  replies   Reply[]
  guilties  Guilty[]
  likes     AnswerLike[]
  reports   Report[]
}

model Session {
  id        String   @id // SHA-256 hash of the cookie token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Question {
  id           String   @id @default(cuid())
  title        String
  description  String?
  category     String
  authorId     String
  createdAt    DateTime @default(now())
  // Denormalized counters so feeds stay fast.
  answerCount  Int      @default(0)
  replyCount   Int      @default(0)
  guiltyCount  Int      @default(0)
  fineCount    Int      @default(0)
  dependsCount Int      @default(0)
  dontCount    Int      @default(0)

  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers  Answer[]
  replies  Reply[]
  guilties Guilty[]

  @@index([createdAt])
  @@index([category, createdAt])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  verdict    String // "fine" | "depends" | "dont"
  body       String
  likeCount  Int      @default(0)
  createdAt  DateTime @default(now())

  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies  Reply[]
  likes    AnswerLike[]

  @@unique([questionId, authorId])
  @@index([createdAt])
}

model Reply {
  id         String   @id @default(cuid())
  answerId   String
  questionId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())

  answer   Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([answerId])
  @@index([createdAt])
}

model Guilty {
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([createdAt])
}

model AnswerLike {
  userId    String
  answerId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([userId, answerId])
}

model Report {
  id         String   @id @default(cuid())
  targetType String // "question" | "answer" | "reply"
  targetId   String
  reason     String?
  reporterId String
  createdAt  DateTime @default(now())

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
}

// One row per page view. visitorId is a random anonymous cookie ID;
// IP addresses are never stored.
model PageView {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
