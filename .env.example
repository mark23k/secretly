# Copy this file to .env and fill it in:   cp .env.example .env

# Database
#   Local (SQLite, nothing to install):  file:./prisma/dev.db
#   Production (PostgreSQL):             postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Switching between them only means changing this line.
DATABASE_URL="file:./prisma/dev.db"

# Optional, for Supabase in production:
#   DATABASE_URL = the "Transaction pooler" URL (port 6543), which handles many
#                  visitors at once
#   DIRECT_URL   = the "Session pooler" URL (port 5432), used only while
#                  deploying to update the tables
# Leave empty for local development.
DIRECT_URL=""

# Optional. Database connections each server copy may open (default 2).
# DB_POOL_MAX="2"

# A long random string that protects login sessions. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# The email that becomes the admin (/admin) when it signs up or logs in.
ADMIN_EMAIL="you@example.com"

# Optional. Timezone used for the "per day" charts in /admin.
ADMIN_TIMEZONE="America/New_York"
