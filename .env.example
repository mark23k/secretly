# Copy this file to .env and fill it in:   cp .env.example .env

# Database
#   Local (SQLite, nothing to install):  file:./prisma/dev.db
#   Production (PostgreSQL):             postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Switching between them only means changing this line.
DATABASE_URL="file:./prisma/dev.db"

# Optional. Only for PostgreSQL behind a connection pooler (e.g. Supabase's
# "Transaction pooler"): put the direct/session connection here so schema
# updates work. Leave empty otherwise.
DIRECT_URL=""

# A long random string that protects login sessions. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# The email that becomes the admin (/admin) when it signs up or logs in.
ADMIN_EMAIL="you@example.com"

# Optional. Timezone used for the "per day" charts in /admin.
ADMIN_TIMEZONE="America/New_York"
