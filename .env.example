# Public site URL (used for metadata / Open Graph). Optional on Netlify, which provides URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API Keys (URL: Project Settings → Data API, without /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Secret used to hash IPs (any long random string)
APP_SECRET=change-me-to-a-long-random-string

# Comma-separated emails of accounts that can open the manager dashboard (/admin)
ADMIN_EMAILS=you@example.com

# Optional: Cloudflare Turnstile bot protection for sign-up / sign-in
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: OpenAI moderation (free endpoint). Leave empty to use the built-in filters only.
OPENAI_API_KEY=

# Optional: set to 1 (then redeploy) to show a "coming soon" page on every public page.
# Manager pages (/admin) and sign-in keep working. Remove it and redeploy to bring the site back.
MAINTENANCE_MODE=
